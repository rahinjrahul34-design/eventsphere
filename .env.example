# ─────────────────────────────────────────────────────────────
# EventSphere environment variables
# Copy to server/.env  (cp .env.example server/.env)
# Every variable below is OPTIONAL for demo mode: without them
# EventSphere runs fully on an in-memory MongoDB with mock
# payments, mock email and the built-in DEMO AI copilot.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database — leave MONGO_URI empty to use an automatic in-memory MongoDB
MONGO_URI=

# Auth — change this in production!
JWT_SECRET=eventsphere_super_secret_change_me
JWT_EXPIRES_IN=7d

# AI — Google Gemini (falls back to DEMO AI mode if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Payments — Razorpay (falls back to DEMO checkout if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image uploads — Cloudinary (falls back to direct image URLs if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Nodemailer SMTP (falls back to console/log transport if empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EventSphere <no-reply@eventsphere.demo>"

# Demo seeding
SEED_ON_START=true
DEMO_MODE=true
