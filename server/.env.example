# ── EventSphere server environment ──
# Copy to server/.env and fill values. Everything runs in DEMO MODE with
# an in-memory MongoDB when MONGO_URI and the API keys are left blank.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Leave empty to use mongodb-memory-server (auto-seeded demo DB)
MONGO_URI=

# Change this in production!
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15d

# Optional: Google sign in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Optional: Google Gemini (AI copilot uses a built-in demo engine if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Razorpay (demo payment simulation if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP email (emails are logged to console in demo mode)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EventSphere <no-reply@eventsphere.demo>"

SEED_ON_START=true
DEMO_MODE=true
